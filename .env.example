# Copy this file to .env and adjust as needed. No real secrets belong here.

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Base directory for runtime artifacts (logs, downloads, screenshots, state)
RUNTIME_DIR=runtime

# Placeholder for future GO/Indigo connection settings (F0.3+, not used yet)
# GO_CONNECTION_TIMEOUT_SECONDS=30
